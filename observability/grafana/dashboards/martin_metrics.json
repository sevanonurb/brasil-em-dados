{
  "title": "Martin — Vector Tile Server",
  "uid": "martin-brasil",
  "schemaVersion": 38,
  "panels": [
    {
      "title": "Requests/s por endpoint",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(martin_http_requests_total[1m])",
        "legendFormat": "{{handler}} {{status}}"
      }]
    },
    {
      "title": "Latência p99 de geração de tile (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(martin_tile_duration_seconds_bucket[5m])) * 1000",
        "legendFormat": "p99 latência"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red",   "value": 500 }
            ]
          }
        }
      }
    },
    {
      "title": "Cache Hit Rate (%)",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "targets": [{
        "expr": "redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total) * 100"
      }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green",  "value": 70 }
            ]
          }
        }
      }
    },
    {
      "title": "Conexões ativas PostGIS",
      "type": "stat",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 6 },
      "targets": [{
        "expr": "pg_stat_activity_count{datname='brasil_dados', state='active'}"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red",    "value": 20 }
            ]
          }
        }
      }
    },
    {
      "title": "Pool PgBouncer — clientes em fila",
      "type": "stat",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 6 },
      "targets": [{
        "expr": "pgbouncer_pools_cl_waiting"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          }
        }
      }
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s"
}
