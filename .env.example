# PostgreSQL / PostGIS
POSTGRES_DB=brasil_dados
POSTGRES_USER=brasil
POSTGRES_PASSWORD=troque_esta_senha

# Grafana
GRAFANA_PASSWORD=troque_esta_senha

# URLs de serviço (para o frontend)
VITE_MARTIN_URL=http://localhost:3000
VITE_API_URL=http://localhost:80

# Dagster
DAGSTER_HOME=/opt/dagster/dagster_home

# Chave de API do IBGE (opcional — SIDRA não requer autenticação)
IBGE_API_KEY=

# Credenciais BigQuery (opcional — para Base dos Dados)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
BIGQUERY_PROJECT_ID=
